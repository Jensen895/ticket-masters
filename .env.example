# Browser-facing URL for the API. Keep this public and non-secret.
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Public-page crawler configuration. Use a descriptive user agent and keep the
# request/cache settings conservative; marketplace pages can rate-limit crawls.
CRAWLER_USER_AGENT=ticket-masters/0.1 (private personal event-price viewer)
CRAWL_TIMEOUT_MS=10000
CRAWL_CACHE_TTL_MS=60000
PRICE_CACHE_TTL_MS=60000

# Service configuration
API_PORT=4000
DATABASE_URL=postgresql://tickets:tickets@localhost:5432/tickets
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
REFRESH_DEADLINE_MS=8000

# Use "memory" for Docker-free UI/API development or "redis" with the worker.
QUEUE_DRIVER=memory
