# Browser-facing URL for the API. Keep this public and non-secret.
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Ticketmaster Discovery API key. Kept server-side by the Next.js API proxy.
# Create one at https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
TICKETMASTER_API_KEY=

# Service configuration
API_PORT=4000
DATABASE_URL=postgresql://tickets:tickets@localhost:5432/tickets
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
REFRESH_DEADLINE_MS=8000

# Use "memory" for Docker-free UI/API development or "redis" with the worker.
QUEUE_DRIVER=memory
